# Supabase Configuration
# Get these values from your Supabase project settings: https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend only (never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_PROJECT_ID=your-project-id

# Google OAuth Configuration
# Create OAuth credentials at: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Environment
NODE_ENV=development

# GoHighLevel Integration
# Private Integration Token for Floristería Lucía subcuenta
# Get this from GoHighLevel dashboard (never commit the real token)
GHL_PRIVATE_INTEGRATION_TOKEN=your-ghl-private-integration-token-here

# Optional: Analytics and Monitoring
# SENTRY_DSN=
# MIXPANEL_TOKEN=
